{
  "cli": {
    "version": ">= 18.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "healthspan-preview": {
      "extends": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_GAINLOG_V2_UI": "1",
        "EXPO_PUBLIC_GAINLOG_V2_TODAY": "0"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
