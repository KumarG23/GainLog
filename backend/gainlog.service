[Unit]
Description=GainLog FastAPI Backend
After=network.target

[Service]
Type=simple
User=gainlog
Group=gainlog
WorkingDirectory=/opt/gainlog/backend-git
EnvironmentFile=/etc/gainlog.env
Environment="GAINLOG_DATABASE_URL=sqlite:////opt/gainlog/backend-git/data/gainlog.db"
ExecStart=/opt/gainlog/venv-new/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
