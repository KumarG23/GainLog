[Unit]
Description=GainLog FastAPI Backend
After=network.target postgresql.service

[Service]
Type=simple
User=gainlog
Group=gainlog
WorkingDirectory=/opt/gainlog/backend-git
EnvironmentFile=/etc/gainlog.env
ExecStart=/opt/gainlog/venv-new/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --no-access-log
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/gainlog/backend-git/data
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
