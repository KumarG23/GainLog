[Unit]
Description=OpenAI private tunnel for GainLog read-only MCP
Wants=network-online.target
After=network-online.target gainlog-mcp-export.service
Requires=gainlog-mcp-reader.socket
After=gainlog-mcp-reader.socket

[Service]
User=gainlog-mcp-tunnel
Group=gainlog-mcp-tunnel
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin /opt/gainlog-mcp/tunnel-client run --config /etc/gainlog-mcp/tunnel.yaml
LoadCredential=openai-key:/etc/gainlog-mcp/openai-runtime-key
RuntimeDirectory=gainlog-mcp-tunnel
RuntimeDirectoryMode=0700
UMask=0077
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TemporaryFileSystem=/run
BindReadOnlyPaths=/run/gainlog-mcp
BindReadOnlyPaths=/etc/gainlog-mcp/resolv.conf:/etc/resolv.conf
IPAddressDeny=127.0.0.0/8
IPAddressDeny=::1/128
IPAddressDeny=169.254.0.0/16
IPAddressDeny=fe80::/10
IPAddressDeny=224.0.0.0/4
IPAddressDeny=ff00::/8
IPAddressDeny=10.0.0.0/8
IPAddressDeny=172.16.0.0/12
IPAddressDeny=192.168.0.0/16
IPAddressDeny=fc00::/7
IPAddressDeny=100.64.0.0/10
InaccessiblePaths=-/opt/gainlog -/var/lib/gainlog-mcp -/etc/gainlog.env -/home -/root
CapabilityBoundingSet=
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectProc=invisible
MemoryMax=256M
TasksMax=32
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
