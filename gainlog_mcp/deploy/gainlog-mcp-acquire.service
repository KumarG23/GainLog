[Unit]
Description=Pull and validate GainLog MCP projection
Requires=gainlog-mcp-source-proxy.socket
After=gainlog-mcp-source-proxy.socket

[Service]
Type=oneshot
User=gainlog-mcp-acquire
Group=gainlog-mcp-acquire
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin PYTHONDONTWRITEBYTECODE=1 /opt/gainlog-mcp/.venv/bin/gainlog-mcp-receive
LoadCredential=source-key:/etc/gainlog-mcp-acquire/id_ed25519
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
TemporaryFileSystem=/run
BindReadOnlyPaths=/run/gainlog-mcp-source-proxy
ReadOnlyPaths=/etc/gainlog-mcp-acquire
ReadWritePaths=/var/lib/gainlog-mcp
InaccessiblePaths=-/etc/gainlog-mcp -/run/gainlog-mcp -/home -/root -/run/dbus -/run/systemd/private -/run/docker.sock -/run/containerd
CapabilityBoundingSet=
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectProc=invisible
ProcSubset=pid
MemoryMax=192M
TasksMax=16
TimeoutStartSec=2min
KillMode=control-group
