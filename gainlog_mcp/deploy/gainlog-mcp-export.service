[Unit]
Description=Export allowlisted GainLog read-only MCP projection
After=local-fs.target
ConditionPathIsReadWrite=/var/lib/gainlog-mcp-source

[Service]
Type=oneshot
User=gainlog-mcp-source
Group=gainlog-mcp-source
EnvironmentFile=/etc/gainlog-mcp.env
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin PYTHONDONTWRITEBYTECODE=1 /opt/gainlog-mcp-source/.venv/bin/gainlog-mcp-export --source ${GAINLOG_MCP_DATABASE_URL} --destination /var/lib/gainlog-mcp-source/projection.db
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
TemporaryFileSystem=/run:ro
BindReadOnlyPaths=/run/postgresql
ReadWritePaths=/var/lib/gainlog-mcp-source
InaccessiblePaths=-/etc/gainlog.env -/home -/root
CapabilityBoundingSet=
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectProc=invisible
ProcSubset=pid
MemoryMax=192M
TasksMax=16
TimeoutStartSec=2min
